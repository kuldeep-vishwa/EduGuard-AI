# ============================================================
# EduGuard AI – Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ----- Flask -----
SECRET_KEY=your-very-secret-key-change-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# ----- Database -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=eduguard_ai

# ----- Upload Paths -----
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216   # 16 MB

# ----- IBM watsonx.ai AI Integration -----
# Step 1: Create/login at https://cloud.ibm.com
# Step 2: Create an API key at https://cloud.ibm.com/iam/apikeys
# Step 3: Visit https://dataplatform.cloud.ibm.com/ → accept Watson Studio terms → create a project
# Step 4: Copy your Project GUID from the project settings URL
# Step 5: Run `flask diagnose-ai` to verify your credentials work
WATSONX_API_KEY=your-ibm-watsonx-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id

# ── Region URL ────────────────────────────────────────────────────────────────
# Australia Sydney (au-syd):  https://au-syd.ml.cloud.ibm.com   ← THIS ACCOUNT
# US South       (us-south):  https://us-south.ml.cloud.ibm.com
# EU Germany     (eu-de):     https://eu-de.ml.cloud.ibm.com
# EU Great Britain (eu-gb):   https://eu-gb.ml.cloud.ibm.com
# Japan          (jp-tok):    https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# ── Model ID ──────────────────────────────────────────────────────────────────
# CONFIRMED WORKING in au-syd (tested 2025, ibm-watsonx-ai 1.6.0):
#   meta-llama/llama-3-3-70b-instruct   ← RECOMMENDED for this account/region
#
# NOT available in au-syd (will fail with model_not_supported):
#   ibm/granite-3-8b-instruct           ← us-south / eu-de only
#   ibm/granite-13b-instruct-v2         ← DEPRECATED everywhere
#
# Run `flask diagnose-ai` to auto-discover all models available to your account.
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# ----- AI Agent Instructions (customize AI behavior without code changes) -----
# Language for AI responses (e.g., English, Formal English)
AI_RESPONSE_LANGUAGE=English
# Response style: concise | detailed | motivational
AI_RESPONSE_STYLE=detailed
# Educational level context
AI_EDUCATION_CONTEXT=undergraduate
# Maximum tokens for AI responses
AI_MAX_TOKENS=1500
# AI temperature (0.0 = deterministic, 1.0 = creative)
AI_TEMPERATURE=0.7
# Safety: strict | moderate (controls content filtering level)
AI_SAFETY_LEVEL=strict
# Custom policy reminder injected into every prompt (leave blank for default)
AI_CUSTOM_POLICY=

# ----- Email Alerts -----
# Set these to enable automatic risk-level email alerts to faculty and students.
# Gmail Setup:
#   1. Enable 2-Step Verification on your Gmail account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
#   4. Paste the 16-character password in MAIL_PASSWORD below
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=EduGuard AI <your-gmail@gmail.com>
